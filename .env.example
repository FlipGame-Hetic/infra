# ---------------------------------------------------------------------------
# PostgreSQL (no longer used — backend uses SQLite)
# ---------------------------------------------------------------------------
# POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# Grafana --set grafana.adminPassword in scripts/deploy.sh
# ---------------------------------------------------------------------------
GRAFANA_PASSWORD=
REVERSE_PROXY=



# BACKEND PODS
# openssl rand -base64 32
SCREEN_JWT_SECRET=
# API
API_PORT=8080
ALLOWED_ORIGINS=http://localhost:3000

# Required minimum 32 characters, no default: openssl rand -base64 48

SCREEN_JWT_SECRET=

# Environment
# Set to "production" to enforce DATABASE_URL / DATABASE_HOST (no SQLite fallback)
APP_ENV=development

# Database — SQLite (fichier persisté dans le pod via PVC monté sur /data)
DATABASE_URL=sqlite:////data/flipper.db

# MQTT (mqtt-bridge)
# MQTT_HOST=mosquitto
# MQTT_PORT=1883
# MQTT_CLIENT_ID=mqtt-bridge
